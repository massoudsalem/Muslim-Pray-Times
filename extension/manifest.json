{
  "manifest_version": 3,
  "name": "Muslim Prayer Times",
  "version": "1.0.0",
  "description": "Daily prayer time calculator with notifications, hijri date, and prayer tracker.",
  "author": "Prayer Times",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "geolocation"
  ],
  "host_permissions": [],
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Prayer Times",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png",
      "48": "assets/icons/icon-48.png"
    }
  },
  "options_page": "options/options.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "{prayer-times@extension}",
      "strict_min_version": "128.0"
    }
  }
}
